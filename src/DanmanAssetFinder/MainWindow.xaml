<Window x:Class="DanmanAssetFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:conv="clr-namespace:DanmanAssetFinder.Converters"
        xmlns:models="clr-namespace:DanmanAssetFinder.Models"
        Title="DANMAN's Asset Finder"
        Width="1400"
        Height="880"
        MinWidth="1040"
        MinHeight="700"
        Background="#FF000000"
        FontFamily="Franklin Gothic Medium, Century Gothic, Segoe UI"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <conv:PathToImageSourceConverter x:Key="PathToImage" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />

        <!-- Royal purple + black -->
        <Color x:Key="Black">#FF000000</Color>
        <Color x:Key="BlackElevated">#FF0C0C0C</Color>
        <Color x:Key="BlackPanel">#FF111111</Color>
        <Color x:Key="BlackTile">#FF161616</Color>
        <Color x:Key="BlackHover">#FF1C1C1C</Color>
        <Color x:Key="Royal">#FF5B21B6</Color>
        <Color x:Key="RoyalBright">#FF7C3AED</Color>
        <Color x:Key="RoyalDeep">#FF3B0764</Color>
        <Color x:Key="Ink">#FFF5F0FF</Color>
        <Color x:Key="Mute">#FF9B8FB8</Color>
        <Color x:Key="Gold">#FFE8D5A3</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Black}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BlackPanel}" />
        <SolidColorBrush x:Key="TileBrush" Color="{StaticResource BlackTile}" />
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource BlackHover}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource RoyalBright}" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource Royal}" />
        <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource RoyalDeep}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Ink}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Mute}" />
        <SolidColorBrush x:Key="FavoriteBrush" Color="{StaticResource Gold}" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Grid.Row="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Orientation="Vertical"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom flat purple scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#FF0A0A0A" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Height="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Height="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Background="#FF5B21B6" Margin="1,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#FF7C3AED" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#FFA78BFA" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Width="0" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Width="0" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#FF5B21B6" Margin="0,1" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Skeleton pulse -->
        <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.7"
                             AutoReverse="True" />
        </Storyboard>

        <Style x:Key="SkeletonBlock" TargetType="Border">
            <Setter Property="Background" Value="#FF2A1548" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource SkeletonPulse}" />
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Flat square button -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF8B5CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDeepBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Bar" Fill="Transparent" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0C0C0C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{StaticResource AccentBrush}" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="#FF0A0A0A" />
            <Setter Property="MinWidth" Value="88" />
        </Style>

        <Style x:Key="SegmentButtonActive" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="FlatField" TargetType="TextBox">
            <Setter Property="Background" Value="#FF0A0A0A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- LEFT RAIL -->
        <DockPanel Grid.Column="0" Background="#FF000000">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource AccentDeepBrush}"
                    Padding="22,28,22,24">
                <StackPanel>
                    <TextBlock Text="DANMAN's"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#FFFFFFFF"
                               LineHeight="30" />
                    <TextBlock Text="ASSET FINDER"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#FFD8B4FE"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding AppVersion}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="18,16"
                       Opacity="0.75" />

            <StackPanel Margin="0,28,0,0">
                <TextBlock Text="LIBRARY"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="22,0,0,12" />

                <!-- Clothes -->
                <Button Content="CLOTHES"
                        Command="{Binding SetCategoryCommand}"
                        CommandParameter="{x:Static models:AssetCategory.Clothes}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Clothes}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource AccentBrush}" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,14"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="PROPS"
                        Command="{Binding SetCategoryCommand}"
                        CommandParameter="{x:Static models:AssetCategory.Props}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Props}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource AccentBrush}" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,14"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="SOUNDS"
                        Command="{Binding SetCategoryCommand}"
                        CommandParameter="{x:Static models:AssetCategory.Sounds}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Sounds}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource AccentBrush}" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,14"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="ENTITIES"
                        Command="{Binding SetCategoryCommand}"
                        CommandParameter="{x:Static models:AssetCategory.Entities}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Entities}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource AccentBrush}" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="18,14"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- CENTER -->
        <Grid Grid.Column="1" Background="#FF050505">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="#FF000000" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClothesCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Content="ALL"
                                Command="{Binding SetClothingFilterCommand}"
                                CommandParameter="{x:Static models:ClothingSourceFilter.All}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClothingFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#FF000000" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="LOCAL"
                                Command="{Binding SetClothingFilterCommand}"
                                CommandParameter="{x:Static models:ClothingSourceFilter.Local}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClothingFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Local}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#FF000000" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="COMMUNITY"
                                Command="{Binding SetClothingFilterCommand}"
                                CommandParameter="{x:Static models:ClothingSourceFilter.Community}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClothingFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Community}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#FF000000" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="FAVORITE"
                                Command="{Binding SetClothingFilterCommand}"
                                CommandParameter="{x:Static models:ClothingSourceFilter.Favorite}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClothingFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Favorite}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource FavoriteBrush}" />
                                            <Setter Property="Foreground" Value="#FF000000" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="REFRESH UGC"
                                Style="{StaticResource FlatButton}"
                                Background="{StaticResource AccentFillBrush}"
                                Margin="12,0,0,0"
                                Command="{Binding RefreshCommunityCommand}"
                                ToolTip="Reload clothing from sbox.game/ugc/clothing" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <TextBox Style="{StaticResource FlatField}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="SEARCH"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Folder strip -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    Padding="20,12"
                    Visibility="{Binding ShowFolderBar, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FOLDER"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource FlatField}"
                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2"
                            Content="BROWSE"
                            Style="{StaticResource FlatButton}"
                            Margin="2,0,0,0"
                            Command="{Binding BrowseFolderCommand}" />
                    <Button Grid.Column="3"
                            Content="RESCAN"
                            Style="{StaticResource FlatButton}"
                            Background="{StaticResource AccentFillBrush}"
                            Margin="2,0,0,0"
                            Command="{Binding RescanCommand}" />
                </Grid>
            </Border>

            <!-- Asset grid -->
            <Grid Grid.Row="2" Background="#FF050505">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">
                    <ItemsControl ItemsSource="{Binding Assets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="156"
                                                Height="204"
                                                Margin="0,0,8,8"
                                                Background="{StaticResource TileBrush}"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="AssetCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="140" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Real card -->
                                                <Grid Background="#FF000000">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowSkeleton}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Image Source="{Binding ThumbnailImage}"
                                                           Stretch="UniformToFill" />
                                                    <TextBlock Text="NO PREVIEW"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasThumbnail}" Value="False" />
                                                                            <Condition Binding="{Binding IsLoadingThumbnail}" Value="False" />
                                                                            <Condition Binding="{Binding IsSkeleton}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Width="28"
                                                            Height="28"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Favorite">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#E6000000">
                                                                    <TextBlock x:Name="Star"
                                                                               Text="☆"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter TargetName="Star" Property="Text" Value="★" />
                                                                        <Setter TargetName="Star" Property="Foreground" Value="{StaticResource FavoriteBrush}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Padding="8,4"
                                                            Background="{StaticResource AccentBrush}"
                                                            Visibility="{Binding IsCommunity, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="UGC"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FF000000" />
                                                    </Border>
                                                </Grid>

                                                <!-- Skeleton card -->
                                                <Grid Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}">
                                                    <Border Style="{StaticResource SkeletonBlock}" />
                                                    <Border Style="{StaticResource SkeletonBlock}"
                                                            Width="40" Height="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="8"
                                                            Background="#FF4C1D95" />
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="10,8,10,8">
                                                    <Border Height="12"
                                                            Margin="0,2,24,0"
                                                            Style="{StaticResource SkeletonBlock}"
                                                            Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" />
                                                    <Border Height="8"
                                                            Margin="0,8,40,0"
                                                            Style="{StaticResource SkeletonBlock}"
                                                            Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSkeleton}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding GamePath}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="9"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding GamePath}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSkeleton}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>

            <!-- Status -->
            <Border Grid.Row="3" Background="#FF000000" Padding="20,10">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           FontFamily="Consolas" />
            </Border>
        </Grid>

        <!-- RIGHT INSPECTOR (scrollable body + pinned actions) -->
        <DockPanel Grid.Column="2" Background="#FF000000">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource AccentFillBrush}"
                    Padding="18,14">
                <TextBlock Text="INSPECTOR"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#FFD8B4FE" />
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
                <Button Content="COPY PATH"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CopyPathCommand}"
                        Margin="0,0,0,2" />
                <Button Content="COPY DISK PATH"
                        Style="{StaticResource FlatButton}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CopyFullPathCommand}"
                        Margin="0,0,0,2" />
                <Button Content="OPEN ON SBOX.GAME"
                        Style="{StaticResource FlatButton}"
                        Background="{StaticResource AccentFillBrush}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenCommunityPageCommand}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel>
                    <Border Background="#FF0A0A0A"
                            Height="240"
                            ClipToBounds="True">
                        <Grid>
                            <hx:HelixViewport3D x:Name="PreviewViewport"
                                                ZoomExtentsWhenLoaded="True"
                                                ShowCoordinateSystem="False"
                                                Background="#FF000000"
                                                Visibility="Collapsed">
                                <hx:DefaultLights />
                            </hx:HelixViewport3D>
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   Margin="0"
                                   Visibility="Collapsed" />
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="SELECT AN ASSET"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" Padding="16,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="36"
                                    Height="36"
                                    Margin="12,0,0,0"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedAsset}"
                                    ToolTip="Favorite">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#FF0A0A0A">
                                            <TextBlock x:Name="Star"
                                                       Text="☆"
                                                       FontSize="16"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIsFavorite}" Value="True">
                                                <Setter TargetName="Star" Property="Text" Value="★" />
                                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource FavoriteBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="PreviewTitle"
                                           Text="—"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviewSubtitle"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Margin="16,16,16,8">
                        <TextBlock Text="PATH" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PreviewGamePath"
                                 Style="{StaticResource FlatField}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="40"
                                 Margin="0,0,0,14" />
                        <TextBlock Text="LINKED MODEL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PreviewModelPath"
                                 Style="{StaticResource FlatField}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="40" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
